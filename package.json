    "dermal-fillers",
    "skincare",
    "clinic",
    "vanilla-js",
    "tailwind-css"
  ],
  "author": "Aurelle Aesthetics",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19"
  },
  "type": "commonjs"
}
