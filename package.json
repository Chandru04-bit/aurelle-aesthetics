{
  "name": "aurelle-aesthetics",
  "version": "1.0.0",
  "description": "Aurelle Aesthetics - Premium Med Spa & Non-Surgical Aesthetics Clinic",
  "main": "js/main.js",
  "scripts": {
    "dev": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
